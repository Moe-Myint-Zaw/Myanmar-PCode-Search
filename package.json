  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "~9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "~3.10.1",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client --scheme myanmarpcode",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "build:database": "python3 scripts/build_bundled_database.py --input data/pcode-compact.json --output assets/database/myanmar_pcode.db",
    "build:dataset": "python3 scripts/prepare_official_places_csv.py --data-dir data --output data/source/places.csv && python3 scripts/build_compact_dataset.py --input data/source/places.csv --output data/pcode-compact.json --version 9.7 --source \"MIMU PCode 9.7 + Myanmar Postal Code + OCHA COD-AB\" && npm run build:database"
  },
  "private": true
